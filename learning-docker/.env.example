# Copie para .env e preencha com valores seguros (nunca commitar .env)
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=changeme_strong_password
MYSQL_DATABASE=db_example
MYSQL_PASSWORD=changeme_strong_password
MYSQL_PORT=30000

# phpMyAdmin
PMA_USER=root
# PMA_PASSWORD deve ser igual a MYSQL_ROOT_PASSWORD se PMA_USER=root
PMA_PORT=8080

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Web
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# PHP
PHP_VERSION=8.2-fpm
APP_DIR=/var/www
